# Leave blank for the Vercel Services deployment and local Vite proxy so the
# browser requests the same-origin /api route. Set only for a deliberately
# separate backend origin.
VITE_API_BASE_URL=

# Local development only: backend origin that Vite proxies /api requests to.
# This value is not exposed to browser code.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
