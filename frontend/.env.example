# Production: set this to the separately deployed backend origin in Vercel.
# Leave blank for local development, which uses Vite's same-origin /api proxy.
VITE_API_BASE_URL=

# Local development only: backend origin that Vite proxies /api requests to.
# This value is not exposed to browser code.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
